# GPT Window Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for GPT Vision functionality)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Input directory for video processing tools
# GPT_WINDOW_INPUT_DIR=./input

# Optional: Output directory for video processing tools
# GPT_WINDOW_OUTPUT_DIR=./output

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# GPT_WINDOW_LOG_LEVEL=INFO

# Optional: Path to log file (leave commented for console-only logging)
# GPT_WINDOW_LOG_FILE=./logs/gpt-window.log
